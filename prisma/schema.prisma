// Prisma 7 client generator; this is the same generator used in your current repository.
generator client {
  // Keep the current package-compatible client rather than changing output conventions.
  provider = "prisma-client-js"
}

// PostgreSQL 16 datasource; URL is supplied by the existing prisma.config.js.
datasource db {
  // The application and Prisma migrations use the PostgreSQL provider.
  provider = "postgresql"
}

// Central identity: never store orders or consultant information in this table.
model User {
  // Better Auth generates opaque IDs; no new public ID format is imposed here.
  id                  String       @id
  // Required display name; phone-first sign-up initially uses a neutral name.
  name                String
  // Better Auth requires a unique email; phone accounts get a reserved .invalid value.
  email               String       @unique
  // A generated placeholder must never count as a verified mailbox.
  emailVerified       Boolean      @default(false)
  // Provider avatar is optional and NOT an identity proof.
  image               String?
  // Canonical E.164 phone number, attached only after successful OTP verification.
  phoneNumber         String?      @unique
  // Explicit mobile ownership flag from the Better Auth phone plugin.
  phoneNumberVerified Boolean?     @default(false)
  // Create/update timestamps are required by the core auth models.
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  // One user can have multiple browser sessions.
  sessions            Session[]
  // One user can have a credential account and a Google account.
  accounts            Account[]
  // Customer-related attributes live outside the auth identity.
  customerProfile     CustomerProfile?
  // Map to the table name generated by the Better Auth Prisma CLI.
  @@map("user")
}

// Stateful, revocable sign-in records.
model Session {
  // Unique database primary key generated by the auth library.
  id         String   @id
  // Session expiration is enforced server-side.
  expiresAt  DateTime
  // Secret random session token; never expose in logging.
  token      String   @unique
  // Session timestamps for rotation and freshness policy.
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Optional telemetry; use trusted proxy configuration for IP.
  ipAddress  String?
  userAgent  String?
  // Stable foreign key to the user identity.
  userId     String
  // Cascading removal prevents orphan auth sessions.
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Accelerate querying a customer's active sessions.
  @@index([userId])
  // Retain the library's expected SQL table name.
  @@map("session")
}

// Credential, Google and future providers share a single identity table.
model Account {
  id                    String    @id
  // For Google, the provider-specific subject (sub); for credentials, library-controlled.
  accountId             String
  // google / credential; NOT a second independent User record.
  providerId            String
  // Referential link back to the single User.
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // OAuth tokens can be absent depending on provider and configuration.
  accessToken           String?
  refreshToken          String?
  idToken               String?
  // Expiration timestamps, if supplied by provider.
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  // OAuth scopes when applicable.
  scope                 String?
  // This contains the salted password hash, never plain text.
  password              String?
  // Better Auth's account bookkeeping timestamps.
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  // A provider identity must not be attached to multiple users.
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

// Short-lived challenges, including built-in OTP verification state.
model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

// Built-in Better Auth request limits (mainly per-IP, not per-phone SMS budgets).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
  @@map("rateLimit")
}

// Independent SMS spending and recipient cooldown limits.
model SmsQuota {
  // `global` or a keyed HMAC digest of the phone number.
  key           String   @id
  // Number of reserved outbound SMS within the current window.
  count         Int      @default(0)
  // Rolling window begins with the first accepted request.
  windowStart   DateTime @default(now())
  // Enforce minimum delay between sends to one number.
  lastReservedAt DateTime?
  @@map("sms_quota")
}

// Domain profile: this is not involved in sign-in or session issuance.
model CustomerProfile {
  // A one-to-one record exists only when profile data is needed.
  userId      String   @id
  fullName    String?
  companyName String?
  province    String?
  city        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("customer_profile")
}
